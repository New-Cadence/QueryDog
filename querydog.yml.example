client: "clienta"
organisation_name: "ACME Corp"

environments:
  - name: "Development"
    environment: "development"
    cluster: false
    scheduler: false
    host: "host.docker.internal"
    port: 8123
    user: "default"
    password: ""
    database: "default"
    secure: false

  - name: "Test"
    environment: "test"
    cluster: true
    host: "your-test-service.eu-west-2.aws.clickhouse.cloud"
    port: 8443
    user: "default"
    password: "your-password"
    database: "default"
    secure: true
    deployment: cloud
    cloud_api:
      key_id: "your-key-id"
      key_secret: "your-key-secret"
      organization_id: "your-organization-id"
      service_id: "your-test-service-id"

  - name: "Production"
    environment: "production"
    default: true
    cluster: true
    cluster_name: "default"
    host: "your-production-service.eu-west-2.aws.clickhouse.cloud"
    port: 8443
    user: "default"
    password: "your-password"
    database: "default"
    secure: true
    deployment: cloud
    cloud_api:
      key_id: "your-key-id"
      key_secret: "your-key-secret"
      organization_id: "your-organization-id"
      service_id: "your-production-service-id"

scheduler:
  enabled: true
  environments: all
  jobs:
    monitoring:
      every: 5m
    dataquality:
      every: 1h
    performance:
      every: 6h
    recommendations:
      every: 6h

# Login (optional). Each user has a username and a scrypt password hash;
# make a hash with: npm run hash-password -- '<password>'
# With no users listed, Convoy runs without a login.
# auth:
#   users:
#     - username: admin
#       password_hash: "scrypt$16384$<salt>$<hash>"
